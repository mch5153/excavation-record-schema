// =============================================================================
// excavation-record-schema — 고고학 발굴조사 기록의 논리 스키마
// Relational logical schema for archaeological excavation records
//
//   논문  고고학 원천자료의 구조화된 적재를 위한 데이터베이스 설계
//         - 월성 발굴조사 자료를 중심으로 -  (민찬홍)
//   범위  논문 Ⅲ장의 30개 릴레이션. 구현 스키마 가운데 시스템 운영용 릴레이션·열은 제외.
//   표기  DBML (https://dbml.dbdiagram.io). dbdiagram.io 에 붙여 넣으면 ERD 가 그려진다.
//
//   [규약]
//   1) 접미사 _cd 를 가진 열은 모두 코드.코드ID 를 참조한다. 허용되는 값의 범위(도메인)는
//      열 note 의 "코드그룹 X" 로 적었고, 코드그룹 목록은 docs/code-groups.md 에 있다.
//      코드사전으로 가는 참조는 파일 끝 [도메인 참조] 블록에 모아 선언했다.
//   2) 릴레이션 사이의 구조 참조(FK)는 열에 인라인 ref 로 선언했다.
//   3) 관계 모델의 선언만으로 표현되지 않는 제약(배타적 아크 등)은 Note 에 적었고,
//      schema.sql 에는 CHECK 로 옮겼다.
//   4) 자료형은 논리 수준(varchar · int · float)이다. 식별자와 날짜는 문자열이다.
// =============================================================================

Project excavation_record_schema {
  database_type: 'SQLite'
  Note: '''
    고고학 발굴조사 원천데이터의 구조화된 적재를 위한 논리 스키마.
    30 릴레이션 · 5 범주 — 공간·층서 / 유구·유물 / 공통 기록 / 어휘 통제·시소러스 / 기록의 변경.
  '''
}


// ─────────────────────────────────────────────────────────────────────────────
// 1. 공간·층서 — 인위적 공간 구획(위계 3단) · 층서(단면도 · 층위 · 층위 간 관계)
// ─────────────────────────────────────────────────────────────────────────────

Table "사업단위" {
  "조사ID"        varchar   [pk]
  "사업명"        varchar
  "조사차수"      varchar
  "조사성격_cd"   int       [note: '코드그룹 조사성격']
  "소재지"        varchar
  "조사면적"      float
  "발굴허가번호"  varchar
  "조사시작일"    varchar
  "조사종료일"    varchar
  "조사기관"      varchar
  "조사단장"      varchar
  "비고"          varchar
  Note: '발굴조사 사업(조사 차수) 단위. 공간 위계 사업단위 › 조사구역 › 발굴구획의 최상위.'
}

Table "조사구역" {
  "구역ID"        varchar   [pk]
  "조사ID"        varchar   [ref: > "사업단위"."조사ID"]
  "상위구역ID"    varchar   [ref: > "조사구역"."구역ID", note: '자기참조 — 지구 › 구역처럼 위계가 여러 번 분화하는 것을 릴레이션 추가 없이 표현']
  "구역명"        varchar
  "유적성격_cd"   int       [note: '코드그룹 유적성격']
  "공간좌표"      varchar
  "조사원"        varchar
  "비고"          varchar
}

Table "발굴구획" {
  "구획ID"        varchar   [pk]
  "구역ID"        varchar   [ref: > "조사구역"."구역ID"]
  "구획구분_cd"   int       [note: '코드그룹 구획구분']
  "구획명"        varchar
  "구획일자"      varchar
  "조사원"        varchar
  "비고"          varchar
}

Table "토층단면도" {
  "단면도ID"      varchar   [pk]
  "단면도명"      varchar
  "비고"          varchar
  Note: '유적·유구 곳곳의 토층 단면 위치를 기록한다. 층위가 여기에 종속되어 위치가 부여된 층서 정보가 된다.'
}

Table "층위" {
  "층위ID"        varchar   [pk]
  "단면도ID"      varchar   [ref: > "토층단면도"."단면도ID"]
  "층위명"        varchar
  "층위구분_cd"   int       [note: '코드그룹 토층분류']
  "추정시기_cd"   int       [note: '코드그룹 시기 · 발굴자의 현장 편년. 종합 편년이 아니라 비가역적인 현장 관찰이므로 기록 대상에 포함']
  "토색_cd"       int       [note: '코드그룹 먼셀토색']
  "토질_cd"       int       [note: '코드그룹 토질']
  "입도_cd"       int       [note: '코드그룹 입도']
  "조사원"        varchar
  "비고"          varchar
}

Table "복합토질" {
  "포함물ID"      varchar   [pk]
  "층위ID"        varchar   [ref: > "층위"."층위ID"]
  "포함물_cd"     int       [note: '코드그룹 포함물']
  "비고"          varchar
  Indexes {
    ("층위ID", "포함물_cd") [unique]
  }
  Note: '한 층위에 혼입된 복수의 포함물(소토 · 목탄 등). 층위당 같은 포함물은 하나.'
}

Table "층위관계" {
  "관계ID"        int       [pk]
  "기준층위ID"    varchar   [ref: > "층위"."층위ID"]
  "대상층위ID"    varchar   [ref: > "층위"."층위ID"]
  "관계유형_cd"   int       [note: '코드그룹 층위관계유형 (층위 ↔ 층위)']
  "비고"          varchar
  Indexes {
    ("기준층위ID", "대상층위ID", "관계유형_cd") [unique]
  }
  Note: '층위 사이의 퇴적 사건을 한 개체로 적재한다. 퇴적은 선후 관계의 일대일 대응을 보장하지 않으므로 어느 한 층위의 속성으로 환원하지 않는다.'
}

Table "매핑_구획_단면도" {
  "매핑ID"        int       [pk]
  "구획ID"        varchar   [ref: > "발굴구획"."구획ID"]
  "단면도ID"      varchar   [ref: > "토층단면도"."단면도ID"]
  "비고"          varchar
  Indexes {
    ("구획ID", "단면도ID") [unique]
  }
  Note: '발굴구획 ↔ 토층단면도 N:M. 단면도는 여러 구획에 걸치고, 한 구획 안에 여러 단면이 생긴다.'
}


// ─────────────────────────────────────────────────────────────────────────────
// 2. 유구·유물 — 유구(맥락의 실체화) · 유물(속성의 원자화, 부위 허브와 관찰 5축)
// ─────────────────────────────────────────────────────────────────────────────

Table "유구" {
  "유구ID"        varchar   [pk]
  "구역ID"        varchar   [ref: > "조사구역"."구역ID"]
  "상위유구ID"    varchar   [ref: > "유구"."유구ID", note: '자기참조 — 포함 계층(고분 › 적석목곽묘 › 목곽). 중첩 · 연접은 유구관계가 받는다']
  "유구명"        varchar
  "유구번호"      varchar   [note: '유구 일련번호']
  "유구분류_cd"   int       [note: '코드그룹 유구분류']
  "추정시기_cd"   int       [note: '코드그룹 시기 · 발굴자의 현장 편년']
  "공간좌표"      varchar
  "평면형태_cd"   int       [note: '코드그룹 평면형태']
  "단면형태_cd"   int       [note: '코드그룹 단면형태']
  "주축방향"      varchar
  "잔존상태_cd"   int       [note: '코드그룹 유구잔존상태']
  "조사원"        varchar
  "비고"          varchar
  Note: '유구 범주의 허브. 공간(조사구역 · 매핑_유구_구획)과 층서(매핑_유구_층위)를 잇는 맥락의 중추.'
}

Table "유구시설" {
  "시설ID"        varchar   [pk]
  "유구ID"        varchar   [ref: > "유구"."유구ID"]
  "시설구분_cd"   int       [note: '코드그룹 시설구분']
  "재질_cd"       int       [note: '코드그룹 재질']
  "잔존상태_cd"   int       [note: '코드그룹 구성요소잔존상태']
  "수량"          int
  "조사원"        varchar
  "비고"          varchar
  Note: '유구에 종속된 구성 설비(적심 · 초석 · 노지 · 주공 등). 개수 · 재질을 갖는 개체이며, 판정값을 담는 고유속성과 구분된다.'
}

Table "유구관계" {
  "관계ID"        int       [pk]
  "기준유구ID"    varchar   [ref: > "유구"."유구ID"]
  "대상유구ID"    varchar   [ref: > "유구"."유구ID"]
  "관계유형_cd"   int       [note: '코드그룹 중첩관계']
  "비고"          varchar
  Indexes {
    ("기준유구ID", "대상유구ID", "관계유형_cd") [unique]
  }
  Note: '중첩 · 연접 · 일부 훼손 등 유구 사이의 관계 사건. 어느 한 유구에 귀속되지 않는 연관 단위.'
}

Table "매핑_유구_구획" {
  "매핑ID"        int       [pk]
  "유구ID"        varchar   [ref: > "유구"."유구ID"]
  "구획ID"        varchar   [ref: > "발굴구획"."구획ID"]
  "비고"          varchar
  Indexes {
    ("유구ID", "구획ID") [unique]
  }
  Note: '유구 ↔ 발굴구획 N:M.'
}

Table "매핑_유구_층위" {
  "매핑ID"        int       [pk]
  "유구ID"        varchar   [ref: > "유구"."유구ID"]
  "층위ID"        varchar   [ref: > "층위"."층위ID"]
  "관계유형_cd"   int       [note: '코드그룹 층서관계유형 (유구 ↔ 층위)']
  "비고"          varchar
  Indexes {
    ("유구ID", "층위ID", "관계유형_cd") [unique]
  }
  Note: '유구 ↔ 층위 N:M. 한 층위에서 여러 유구가, 한 유구에서 여러 층위가 나온다.'
}

Table "유물" {
  "유물ID"        varchar   [pk]
  "출토층위ID"    varchar   [ref: > "층위"."층위ID"]
  "구획ID"        varchar   [ref: > "발굴구획"."구획ID"]
  "유구ID"        varchar   [ref: > "유구"."유구ID"]
  "유물명"        varchar
  "유물번호"      varchar   [note: '유물 일련번호 (현장 · 정리 번호)']
  "유물분류_cd"   int       [note: '코드그룹 유물분류']
  "추정시기_cd"   int       [note: '코드그룹 시기 · 발굴자의 현장 편년']
  "출토위치"      varchar
  "공간좌표"      varchar
  "수량"          int
  "잔존상태_cd"   int       [note: '코드그룹 유물잔존상태']
  "수습일자"      varchar
  "조사원"        varchar
  "비고"          varchar
  Note: '유물 범주의 허브. 수직 위계(대 · 중 · 소 분류)는 릴레이션이 아니라 유물분류_cd 의 코드 계층이 진다 — IS-A 하위 릴레이션을 두지 않는다.'
}

Table "유물부위" {
  "유물부위ID"    varchar   [pk]
  "유물ID"        varchar   [ref: > "유물"."유물ID"]
  "부위_cd"       int       [note: '코드그룹 부위 · 유물분류에 따라 허용 부위가 코드관계매핑으로 제한된다']
  "내면/외면"     int
  "재질_cd"       int       [note: '코드그룹 태토']
  "색조_cd"       int       [note: '코드그룹 색조']
  "비고"          varchar
  Indexes {
    ("유물ID", "부위_cd") [unique]
  }
  Note: '관찰 5축(표면흔적 · 제작속성 · 형태요소 · 문양 · 명문)이 매달리는 허브. 한 유물에 같은 부위는 하나. 재질 · 색조는 유물 전체가 아니라 부위에 1:1 대응하므로 여기에 둔다.'
}

Table "표면흔적" {
  "표면흔적ID"    varchar   [pk]
  "유물부위ID"    varchar   [ref: > "유물부위"."유물부위ID"]
  "흔적종류_cd"   int       [note: '코드그룹 흔적종류']
  "비고"          varchar
  Note: '표면에 남은 자국과 처리 흔적(타날흔 · 물손질흔 · 시유 등) — 관찰의 기록.'
}

Table "제작속성" {
  "제작속성ID"    varchar   [pk]
  "유물부위ID"    varchar   [not null, ref: > "유물부위"."유물부위ID"]
  "제작속성_cd"   int       [not null, note: '코드그룹 제작속성 · 대분류 = 공정단계(성형 / 조정 / 표면처리 / 접합 / 시문 / 소성), 중분류 = 그 아래 값']
  "재료_cd"       int       [note: '코드그룹 사용재료 · 표면처리에 쓰인 재료']
  "비고"          varchar
  Indexes {
    ("유물부위ID", "제작속성_cd") [unique]
  }
  Note: '공정 단계의 판정. 표면흔적(관찰)과 분리해 두어 근거를 남긴 채 판정만 갱신할 수 있다.'
}

Table "형태요소" {
  "형태요소ID"    varchar   [pk]
  "유물부위ID"    varchar   [ref: > "유물부위"."유물부위ID"]
  "형태요소_cd"   int       [note: '코드그룹 형태요소']
  "수량"          int
  "비고"          varchar
  Note: '유물에 가해진 입체적 조형 요소(투창 · 돌대 등).'
}

Table "문양" {
  "문양ID"        varchar   [pk]
  "유물부위ID"    varchar   [ref: > "유물부위"."유물부위ID"]
  "문양구분_cd"   int       [note: '코드그룹 문양']
  "비고"          varchar
  Note: '부위에 표현된 도상. 문양별 세부 속성(연화문의 연판 · 자방 등)은 전용 릴레이션이 아니라 고유속성이 값으로 받는다 — 자료가 늘 때 늘어나는 것이 값이 아니라 항목인 축은 스키마가 아니라 코드가 받는다.'
}

Table "명문" {
  "명문ID"        varchar   [pk]
  "유물부위ID"    varchar   [ref: > "유물부위"."유물부위ID"]
  "명문내용"      varchar
  "비고"          varchar
  Note: '유물에 새겨진 문자 흔적.'
}

Table "유물조합" {
  "조합ID"        varchar   [pk]
  "조합유형_cd"   int       [note: '코드그룹 조합유형']
  "조합유물명"    varchar
  "비고"          varchar
  Note: '접합 · 쌍 · 연 · 조 등 유물의 조합 관계를 후속 사건에 따른 새 개체로 적재한다.'
}

Table "조합개체" {
  "매핑ID"        int       [pk]
  "유물ID"        varchar   [ref: > "유물"."유물ID"]
  "조합ID"        varchar   [ref: > "유물조합"."조합ID"]
  "비고"          varchar
  Note: '유물 ↔ 유물조합 N:M. 조합에 참여하는 유물의 참여 관계.'
}


// ─────────────────────────────────────────────────────────────────────────────
// 3. 공통 기록 — 범주를 횡단하는 조사 산출물 (측정 · 시료 · 과학분석 · 조사자료)
// ─────────────────────────────────────────────────────────────────────────────

Table "측정" {
  "측정ID"        varchar   [pk]
  "유구ID"        varchar   [ref: > "유구"."유구ID"]
  "층위ID"        varchar   [ref: > "층위"."층위ID"]
  "시설ID"        varchar   [ref: > "유구시설"."시설ID"]
  "유물부위ID"    varchar   [ref: > "유물부위"."유물부위ID"]
  "시료ID"        varchar   [ref: > "시료"."시료ID"]
  "측정항목_cd"   int       [note: '코드그룹 측정항목']
  "측정값"        float
  "측정단위_cd"   int       [note: '코드그룹 측정단위']
  "측정방법_cd"   int       [note: '코드그룹 측정방법']
  "측정자"        varchar
  "측정일자"      varchar
  "비고"          varchar
  Note: '범용 계측 릴레이션. 유구 · 층위 · 유구시설 · 유물부위 · 시료 5종 부모 가운데 하나를 참조한다. 코드값이 아니라 수(數)로 기록되는 축은 여기가 받는다.'
}

Table "시료" {
  "시료ID"        varchar   [pk]
  "층위ID"        varchar   [ref: > "층위"."층위ID"]
  "유구ID"        varchar   [ref: > "유구"."유구ID"]
  "구획ID"        varchar   [ref: > "발굴구획"."구획ID"]
  "유물ID"        varchar   [ref: > "유물"."유물ID"]
  "시료번호"      varchar
  "채취일자"      varchar
  "채취자"        varchar
  "채취부위"      varchar
  "비고"          varchar
  Note: '채취 대상 4종(층위 · 유구 · 발굴구획 · 유물) 가운데 하나를 참조한다.'
}

Table "과학분석" {
  "분석ID"        varchar   [pk]
  "시료ID"        varchar   [ref: > "시료"."시료ID"]
  "유물ID"        varchar   [ref: > "유물"."유물ID", note: '비파괴 분석의 대상 유물. 시료ID 와 배타적']
  "분석종류_cd"   int       [note: '코드그룹 분석종류']
  "측정값"        float
  "오차"          float
  "측정단위_cd"   int       [note: '코드그룹 측정단위']
  "분석자"        varchar
  "분석기관"      varchar
  "분석일자"      varchar
  "비고"          varchar
  Note: '시료를 경유하는 분석(파괴)과 유물을 직접 대상으로 하는 분석(비파괴)의 두 갈래. CHECK: 시료ID · 유물ID 가운데 정확히 하나만 NOT NULL.'
}

Table "조사자료" {
  "조사자료ID"    varchar   [pk]
  "조사ID"        varchar   [ref: > "사업단위"."조사ID"]
  "구획ID"        varchar   [ref: > "발굴구획"."구획ID"]
  "단면도ID"      varchar   [ref: > "토층단면도"."단면도ID"]
  "층위ID"        varchar   [ref: > "층위"."층위ID"]
  "유구ID"        varchar   [ref: > "유구"."유구ID"]
  "유물ID"        varchar   [ref: > "유물"."유물ID"]
  "자료유형_cd"   int       [note: '코드그룹 자료유형']
  "자료번호"      varchar
  "저장위치"      varchar
  "원본파일명"    varchar
  "확장자"        varchar
  "등록일자"      varchar
  "등록자"        varchar
  "비고"          varchar
  Note: '사진 · 도면 · 3D 등 조사 산출물의 카탈로그(메타데이터와 색인). 주대상 FK 6종(조사 · 구획 · 단면도 · 층위 · 유구 · 유물) 가운데 정확히 하나만 채운다 — 여럿이면 삭제 연쇄에서 어느 것을 따라야 하는지 정해지지 않는다. CHECK: 6종 가운데 정확히 하나만 NOT NULL.'
}


// ─────────────────────────────────────────────────────────────────────────────
// 4. 어휘 통제·시소러스 — 코드사전 · 코드 간 규칙 · 코드값형 가변축(고유속성)
// ─────────────────────────────────────────────────────────────────────────────

Table "코드" {
  "코드ID"        int       [pk]
  "코드그룹"      varchar
  "상위코드ID"    int       [ref: > "코드"."코드ID", note: '자기참조 — 수직 분류 체계(시소러스의 계층 관계)']
  "코드값"        varchar
  "정렬순서"      int
  "사용여부"      int
  Indexes {
    ("코드ID", "상위코드ID") [unique]
    ("코드그룹", "상위코드ID", "코드값") [unique]
  }
  Note: '어휘 사전. 모든 _cd 열의 도착점. 유일키가 (코드그룹, 상위코드ID, 코드값)이므로 같은 코드값이 부모만 달리해 여럿 있을 수 있다. (코드ID, 상위코드ID) 유일키는 고유속성의 복합 FK 가 참조한다.'
}

Table "코드관계매핑" {
  "매핑ID"        int       [pk]
  "기준코드ID"    int       [not null, ref: > "코드"."코드ID"]
  "대상코드ID"    int       [not null, ref: > "코드"."코드ID"]
  "관계유형_cd"   int       [not null, note: '코드그룹 관계유형 — 부위적용가능 · 문양적용가능 · 속성적용가능 · 흔적적용가능 · 면적용가능 · 재료적용가능 · 동의어 · 관련어']
  "비고"          varchar
  Indexes {
    ("기준코드ID", "대상코드ID", "관계유형_cd") [unique]
  }
  Note: '코드 사이의 수평 규칙(시소러스의 연관 · 등가 관계). 기준 코드의 상위 마디에 걸면 하위 마디가 상속한다. 예: 유물분류.수막새 → 부위.화판부 (부위적용가능).'
}

Table "고유속성" {
  "고유속성ID"    int       [pk]
  "유물ID"        varchar   [ref: > "유물"."유물ID"]
  "유물부위ID"    varchar   [ref: > "유물부위"."유물부위ID"]
  "유구ID"        varchar   [ref: > "유구"."유구ID"]
  "유구시설ID"    varchar   [ref: > "유구시설"."시설ID"]
  "문양ID"        varchar   [ref: > "문양"."문양ID"]
  "속성_cd"       int       [not null, note: '코드그룹 고유속성항목 · 속성을 정의하는 마디']
  "속성값_cd"     int       [not null, note: '속성_cd 의 자식 마디. 복합 FK (속성값_cd, 속성_cd) → 코드(코드ID, 상위코드ID) 로 부모-자식 정합성을 강제']
  "비고"          varchar
  Indexes {
    ("유물ID", "속성_cd") [unique]
    ("유물부위ID", "속성_cd") [unique]
    ("유구ID", "속성_cd") [unique]
    ("유구시설ID", "속성_cd") [unique]
    ("문양ID", "속성_cd") [unique]
  }
  Note: '분류 체계에서 파생되는 세부 속성을 대상 - 속성 - 값 삼항으로 적재하는 횡단 릴레이션. 분류가 속성을 부른다 — 코드관계매핑(속성적용가능)이 유구분류 · 유물분류 · 문양 → 고유속성항목 을 선언하고, 입력은 그 선언만큼만 열린다. 새 속성 축은 코드 추가만으로 수용한다. CHECK: 부모 5종(유물 · 유물부위 · 유구 · 유구시설 · 문양) 가운데 정확히 하나만 NOT NULL (배타적 아크). 개체당 같은 속성은 하나.'
}


// ─────────────────────────────────────────────────────────────────────────────
// 5. 기록의 변경 — 기록에 관한 기록
// ─────────────────────────────────────────────────────────────────────────────

Table "변경기록" {
  "변경ID"        int       [pk]
  "대상릴레이션"  varchar   [not null]
  "대상키"        varchar   [not null]
  "대상속성"      varchar   [not null]
  "변경전"        varchar
  "변경후"        varchar
  "변경일시"      varchar
  "변경자"        varchar
  "변경사유"      varchar
  "비고"          varchar
  Note: '값의 갱신을 하나의 사건으로 적재한다. 개체 릴레이션에는 늘 현재의 확정값만 두어 조회를 단순하게 유지하고(현재 상태와 이력의 분리), 값이 그 값이 되기까지의 경위를 사후 검증의 근거로 남긴다. 대상 행은 (대상릴레이션, 대상키) 문자열로 가리킨다 — 대상 행이 삭제되어도 이력은 남아야 하므로 FK 를 걸지 않는다.'
}


