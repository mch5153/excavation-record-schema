// =============================================================================
// [도메인 참조] — 모든 _cd 열 → 코드.코드ID. 허용 코드그룹은 각 열의 note 참조.
//   ERD 에서는 이 선들이 한 점(코드)으로 수렴해 도표를 덮으므로 docs/erd.md 는 생략해 그린다.
// =============================================================================

// 공간·층서
Ref: "사업단위"."조사성격_cd" > "코드"."코드ID"
Ref: "조사구역"."유적성격_cd" > "코드"."코드ID"
Ref: "발굴구획"."구획구분_cd" > "코드"."코드ID"
Ref: "층위"."층위구분_cd" > "코드"."코드ID"
Ref: "층위"."추정시기_cd" > "코드"."코드ID"
Ref: "층위"."토색_cd" > "코드"."코드ID"
Ref: "층위"."토질_cd" > "코드"."코드ID"
Ref: "층위"."입도_cd" > "코드"."코드ID"
Ref: "복합토질"."포함물_cd" > "코드"."코드ID"
Ref: "층위관계"."관계유형_cd" > "코드"."코드ID"

// 유구·유물
Ref: "유구"."유구분류_cd" > "코드"."코드ID"
Ref: "유구"."추정시기_cd" > "코드"."코드ID"
Ref: "유구"."평면형태_cd" > "코드"."코드ID"
Ref: "유구"."단면형태_cd" > "코드"."코드ID"
Ref: "유구"."잔존상태_cd" > "코드"."코드ID"
Ref: "유구시설"."시설구분_cd" > "코드"."코드ID"
Ref: "유구시설"."재질_cd" > "코드"."코드ID"
Ref: "유구시설"."잔존상태_cd" > "코드"."코드ID"
Ref: "유구관계"."관계유형_cd" > "코드"."코드ID"
Ref: "매핑_유구_층위"."관계유형_cd" > "코드"."코드ID"
Ref: "유물"."유물분류_cd" > "코드"."코드ID"
Ref: "유물"."추정시기_cd" > "코드"."코드ID"
Ref: "유물"."잔존상태_cd" > "코드"."코드ID"
Ref: "유물부위"."부위_cd" > "코드"."코드ID"
Ref: "유물부위"."재질_cd" > "코드"."코드ID"
Ref: "유물부위"."색조_cd" > "코드"."코드ID"
Ref: "표면흔적"."흔적종류_cd" > "코드"."코드ID"
Ref: "제작속성"."제작속성_cd" > "코드"."코드ID"
Ref: "제작속성"."재료_cd" > "코드"."코드ID"
Ref: "형태요소"."형태요소_cd" > "코드"."코드ID"
Ref: "문양"."문양구분_cd" > "코드"."코드ID"
Ref: "유물조합"."조합유형_cd" > "코드"."코드ID"

// 공통 기록
Ref: "측정"."측정항목_cd" > "코드"."코드ID"
Ref: "측정"."측정단위_cd" > "코드"."코드ID"
Ref: "측정"."측정방법_cd" > "코드"."코드ID"
Ref: "과학분석"."분석종류_cd" > "코드"."코드ID"
Ref: "과학분석"."측정단위_cd" > "코드"."코드ID"
Ref: "조사자료"."자료유형_cd" > "코드"."코드ID"

// 어휘 통제·시소러스
Ref: "코드관계매핑"."관계유형_cd" > "코드"."코드ID"
Ref: "고유속성"."속성_cd" > "코드"."코드ID"
Ref: "고유속성".("속성값_cd", "속성_cd") > "코드".("코드ID", "상위코드ID")
